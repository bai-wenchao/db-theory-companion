# macOS
.DS_Store

# python
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# Source data: fetched corpus — paper lists, downloaded PDFs/TeX, extractions.
# Regenerate via scripts 01–02c + 03/04/04t (see CLAUDE.md pipeline):
#   papers.jsonl + manifest.jsonl + s2_arxiv_map.json  <- 01 + download byproducts
#   src/ pdfs/ txt/ manual_pdfs/                        <- 02t/02/02c/03
#   theory/                                             <- 04/04t
# ---------------------------------------------------------------------------
/data/

# ---------------------------------------------------------------------------
# Script-generated aggregates (regenerate after the data stage):
#   index/* <- 05_build_index.py + 06_tag_stats.py
# ---------------------------------------------------------------------------
/index/

# ---------------------------------------------------------------------------
# Survey analysis outputs (LLM-generated, kept local):
#   notes/        — per-paper analysis batches (batch_*.md)
#   report/       — synthesized survey + addendum
#   CHECKPOINT.md — quota-governor state file
# ---------------------------------------------------------------------------
/notes/
/report/
/CHECKPOINT.md

# ---------------------------------------------------------------------------
# Lecture notes — generated assets (regenerate after the analysis stage):
#   plan.json             <- 07_plan_chapters.py
#   figures/              <- 08_make_figures.py (matplotlib, from index/sigmod26_tags.md)
#   refs.bib, all.bib     <- 09_make_bib.py (corpus refs from papers.jsonl)
#   digest/               <- 10_make_digests.py (per-chapter theory digests)
#   chapters/index.tex    <- 11_make_index.py (back-matter index)
#   chapters/*-all.bib    <- 12_chapter_bibs.py (cited-subset chapter bibs)
# ---------------------------------------------------------------------------
lecture-notes/plan.json
lecture-notes/figures/
lecture-notes/digest/
lecture-notes/refs.bib
lecture-notes/all.bib
lecture-notes/chapters/index.tex
lecture-notes/chapters/*-all.bib

# Book build output + per-run stamp (./build.sh main); retired pilot driver
# (regenerated by `./build.sh pilot`)
lecture-notes/main.pdf
lecture-notes/buildstamp.tex
lecture-notes/main-pilot.*

# LaTeX build artifacts (aux/bbl/log/toc/... are regenerated by build.sh)
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.log
*.out
*.toc
*.lof
*.lot
*.synctex.gz
